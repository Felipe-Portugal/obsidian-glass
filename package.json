{
  "name": "obsidian-glass",
  "private": true,
  "version": "1.0.0",
  "description": "ePortfolio de Felipe Portugal, étudiant en génie logiciel à l'ÉTS.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/prerender.ts --outDir node_modules/.prerender && node scripts/prerender.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/extract-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@formspree/core": "^4.0.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "2.0.8",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "devicon": "^2.17.0",
    "jsdom": "^27.0.1",
    "oxlint": "^1.88.0",
    "simple-icons": "^16.35.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "4.1.12"
  }
}
